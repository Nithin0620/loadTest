{
  "name": "loadcheck",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Developer-centric HTTP load testing platform powered by k6, Next.js, and MongoDB",
  "scripts": {
    "dev": "node scripts/ensure-k6.js && next dev",
    "build": "node scripts/ensure-k6.js && next build",
